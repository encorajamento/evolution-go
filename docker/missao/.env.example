# Copie para .env na mesma pasta do docker-compose.yml e edite.
# Os valores abaixo alimentam as env vars do container via ${VAR}.

# Admin key do próprio Evolution (usada pelas rotas /instance/create, /instance/all, etc.)
EVOLUTION_GLOBAL_API_KEY=global_6b599a5c96c93a508491dc4d1ecc5462

# URL para onde o Evolution vai postar TODOS os eventos de TODAS as instâncias.
# host.containers.internal = host que roda o backend Nest (Podman/Docker Desktop mapeiam automaticamente).
# Porta 4000 = onde o backend Nest escuta; mantenha /api/public/whatsapp/webhook/<WHATSAPP_WEBHOOK_SECRET>
# com o MESMO secret configurado no .env do backend (grupos-encorajamento-api/.env).
EVOLUTION_WEBHOOK_URL=http://host.containers.internal:4000/api/public/whatsapp/webhook/44b7d38271bd5b086c808208076e7857444ee2198cb524a6f934863a4ae5db5b

# === Storage MinIO / S3 ===
# Sem isso, URLs de mídia vêm direto do WhatsApp e EXPIRAM em poucas horas.
# Com isso ativado, Evolution baixa e sobe pro bucket no momento que a msg chega.
# Pode usar o MESMO S3 que o backend já usa (s3.encorajamento.com.br) ou um bucket dedicado.
MINIO_ENABLED=true
MINIO_ENDPOINT=s3.encorajamento.com.br
MINIO_ACCESS_KEY=alfa
MINIO_SECRET_KEY=&yA1x2Y8
MINIO_BUCKET=grupos-de-encorajamento
MINIO_REGION=us-east-1
MINIO_USE_SSL=true
